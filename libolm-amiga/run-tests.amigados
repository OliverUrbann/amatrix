; libolm unit tests on AmigaOS. Expects the test programs in Extra:
; (or change the path below).  Results go to SYS:out.txt.
FailAt 1000
Stack 262144
Echo "== libolm unit tests" >SYS:out.txt
Version >>SYS:out.txt
Date >>SYS:out.txt
List Extra:test_#? LFORMAT="Extra:%n >>SYS:out.txt" >RAM:runall
Execute RAM:runall
Date >>SYS:out.txt
Echo "done" >SYS:amiga-done
